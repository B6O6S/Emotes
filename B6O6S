--==================================================
-- SLIDERS
--==================================================

local activeSlider = nil

sizeContainer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        if not activeSlider then
            activeSlider = "size"
            isMenuDraggingEnabled = false
        end
    end
end)

transContainer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        if not activeSlider then
            activeSlider = "trans"
            isMenuDraggingEnabled = false
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        if activeSlider then
            activeSlider = nil
            isMenuDraggingEnabled = true
            saveSettings()
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not activeSlider then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if activeSlider == "size" then

        local mousePos = input.Position.X
        local absPos = sizeContainer.AbsolutePosition.X
        local absSize = sizeContainer.AbsoluteSize.X

        local alpha = math.clamp(
            (mousePos - absPos) / absSize,
            0,
            1
        )

        local newSize = math.floor(
            24 + alpha * (80 - 24)
        )

        savedData.settings.size = newSize

        updateSizeTextAndFill()

        for id, frame in pairs(shortcuts) do
            for _, emote in ipairs(emotes) do
                if emote.id == id then
                    applyShortcutAppearance(frame, emote)
                    break
                end
            end
        end

    elseif activeSlider == "trans" then

        local mousePos = input.Position.X
        local absPos = transContainer.AbsolutePosition.X
        local absSize = transContainer.AbsoluteSize.X

        local alpha = math.clamp(
            (mousePos - absPos) / absSize,
            0,
            1
        )

        savedData.settings.shortcutTransparency = alpha

        updateTransTextAndFill()

        for _, frame in pairs(shortcuts) do
            frame.BackgroundTransparency = alpha
        end
    end
end)

