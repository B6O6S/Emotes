    sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
end

local function updateTransTextAndFill()
    local trans = savedData.settings.shortcutTransparency

    transSliderText.Text =
        "Transparency: " ..
        math.floor(trans * 100) ..
        "%"

    transSliderFill.Size =
        UDim2.new(trans, 0, 1, 0)
end

local function updateRainbowText()
    if savedData.settings.rainbowOutline then
        rainbowToggleBtn.Text = "Rainbow Outline: On"
    else
        rainbowToggleBtn.Text = "Rainbow Outline: Off"
    end
end

