--==================================================
-- CREATE SHORTCUT
--==================================================

local function toggleShortcut(emote, savedPos, saveToDisk)

    -- Remove existing shortcut
    if shortcuts[emote.id] then

        shortcuts[emote.id]:Destroy()
        shortcuts[emote.id] = nil

        if saveToDisk ~= false then
            saveSettings()
        end

        return
    end

    -- Shortcut frame
    local shortcutFrame = Instance.new("Frame")
    shortcutFrame.Name = "Shortcut_" .. tostring(emote.id)

    if savedPos then
        shortcutFrame.Position = UDim2.new(
            savedPos[1],
            savedPos[2],
            savedPos[3],
            savedPos[4]
        )
    else
        shortcutFrame.Position = UDim2.new(
            0,
            140,
            0,
            20
        )
    end

    shortcutFrame.BackgroundColor3 =
        Color3.fromRGB(22, 22, 28)

    shortcutFrame.BackgroundTransparency =
        savedData.settings.shortcutTransparency

    shortcutFrame.BorderSizePixel = 0
    shortcutFrame.Active = true
    shortcutFrame.Parent = screenGui

    -- Corner
    local scCorner = Instance.new("UICorner")
    scCorner.CornerRadius = UDim.new(0, 8)
    scCorner.Parent = shortcutFrame

    -- Outline
    local scStroke = Instance.new("UIStroke")
    scStroke.Thickness = 1.5
    scStroke.Parent = shortcutFrame

    -- Button
    local shortcutBtn = Instance.new("TextButton")
    shortcutBtn.Name = "ShortcutButton"
    shortcutBtn.Size = UDim2.new(1, 0, 1, 0)
    shortcutBtn.BackgroundTransparency = 1
    shortcutBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    shortcutBtn.Font = Enum.Font.GothamMedium
    shortcutBtn.AutoButtonColor = false
    shortcutBtn.Parent = shortcutFrame

    addTextStroke(shortcutBtn)

    -- Apply appearance
    applyShortcutAppearance(
        shortcutFrame,
        emote
    )

    -- IMPORTANT:
    -- Mobile/PC drag handler
    makeShortcutDraggable(
        shortcutFrame,
        shortcutBtn,
        emote
    )

    shortcuts[emote.id] = shortcutFrame

    if saveToDisk ~= false then
        saveSettings()
    end
end

