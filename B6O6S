    local trans = savedData.settings.shortcutTransparency
    transSliderText.Text = "Transparency: " .. math.floor(trans * 100) .. "%"
    transSliderFill.Size = UDim2.new(trans, 0, 1, 0)
end

local function updateRainbowText()
    if savedData.settings.rainbowOutline then
        rainbowToggleBtn.Text = "Rainbow Outline: On"
    else
        rainbowToggleBtn.Text = "Rainbow Outline: Off"
    end
end

updateDisplayModeText()
updateSizeTextAndFill()
updateTransTextAndFill()
updateRainbowText()

local function applyShortcutAppearance(frame, emote)
    local size = savedData.settings.size
    frame.BackgroundTransparency = savedData.settings.shortcutTransparency
    
    local textBtn = frame:FindFirstChildOfClass("TextButton")
    local thumbImg = frame:FindFirstChild("ShortcutThumb")
    
    if savedData.settings.displayMode == "thumbnail" then
        frame.Size = UDim2.new(0, size, 0, size)
        if textBtn then textBtn.Text = "" end
        if not thumbImg then
            thumbImg = Instance.new("ImageLabel")
            thumbImg.Name = "ShortcutThumb"
            thumbImg.Size = UDim2.new(1, 0, 1, 0)
            thumbImg.BackgroundTransparency = 1
            thumbImg.Image = "rbxthumb://type=Asset&id=" .. emote.id .. "&w=150&h=150"
            thumbImg.Parent = frame
            local imgCorner = Instance.new("UICorner")
            imgCorner.CornerRadius = UDim.new(0, 8)
            imgCorner.Parent = thumbImg
        else
            thumbImg.Visible = true
        end
    else
        local width = math.floor(size * 2.8)
        frame.Size = UDim2.new(0, width, 0, size)
        if textBtn then
            textBtn.TextSize = math.clamp(math.floor(size * 0.35), 9, 16)
            textBtn.Text = emote.name
        end
        if thumbImg then thumbImg.Visible = false end
    end
end

