local function playEmoteById(assetId)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local success = pcall(function()
        humanoid:PlayEmoteAndGetAnimTrackById(assetId)
    end)

    if not success then
        local desc = humanoid:FindFirstChildOfClass("HumanoidDescription")
        if desc then
            desc:AddEmote("Custom", assetId)
            humanoid:PlayEmoteAndGetAnimTrackById(assetId)
        end
    end
end

local function saveSettings()
    pcall(function()
        if writefile then
            local dataToSave = { 
                shortcuts = {}, 
                settings = savedData.settings 
            }
            for id, frame in pairs(shortcuts) do
                local pos = frame.Position
                dataToSave.shortcuts[tostring(id)] = {
                    pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset
                }
            end
            writefile(saveDataFileName, HttpService:JSONEncode(dataToSave))
        end
    end)
end

local function makeDraggable(gui, onDragEnded)
    local dragging, dragInput, dragStart, startPos

    gui.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch) and isMenuDraggingEnabled then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if onDragEnded then onDragEnded() end
                end
            end)
        end
    end)

    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement 
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging and isMenuDraggingEnabled then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

