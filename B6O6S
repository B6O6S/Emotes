searchBox:GetPropertyChangedSignal("Text"):Connect(function()

    local query = string.lower(searchBox.Text)

    for _, emote in ipairs(emotes) do

        local frame = containerFrames[emote.id]

        if frame then

            if query == ""
            or string.find(
                string.lower(emote.name),
                query,
                1,
                true
            ) then

                frame.Visible = true

            else
                frame.Visible = false
            end
        end
    end
end)

