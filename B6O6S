            if query == "" or string.find(string.lower(emote.name), query) then
                frame.Visible = true
            else
                frame.Visible = false
            end
        end
    end
end)

if savedData.shortcuts then
    for idStr, posData in pairs(savedData.shortcuts) do
        local id = tonumber(idStr)
        if id then
            for _, emote in ipairs(emotes) do
                if emote.id == id then
                    toggleShortcut(emote, posData, false)
                    break
                end
            end
        end
    end
